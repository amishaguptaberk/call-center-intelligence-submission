{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.call-center/evaluation/schemas/annotation.schema.json",
  "title": "CallCenterSpeakerAnnotation",
  "description": "Canonical speaker annotation as time intervals on a recording. Not ASR segment indices. Unlabeled regions must not be scored as correct.",
  "type": "object",
  "required": [
    "schema_version",
    "recording_id",
    "audio",
    "label_set",
    "intervals",
    "overlap_policy",
    "unlabeled_policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "recording_id": { "type": "string", "minLength": 1 },
    "draft": { "type": "boolean" },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "audio": {
      "type": "object",
      "required": ["filename"],
      "additionalProperties": false,
      "properties": {
        "filename": { "type": "string" },
        "sha256": { "type": ["string", "null"] },
        "duration_sec": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "label_set": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "enum": ["Agent", "Customer"] }
    },
    "overlap_policy": {
      "type": "string",
      "enum": ["allow_overlapping_intervals", "forbid_overlapping_intervals"]
    },
    "unlabeled_policy": {
      "type": "string",
      "const": "do_not_score"
    },
    "intervals": {
      "type": "array",
      "items": { "$ref": "#/$defs/interval" }
    }
  },
  "$defs": {
    "interval": {
      "type": "object",
      "required": ["id", "start_sec", "end_sec", "status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "start_sec": { "type": "number", "minimum": 0 },
        "end_sec": { "type": "number", "minimum": 0 },
        "label": {
          "description": "Required when status is clear. Null for ambiguous/overlap/mixed/excluded.",
          "type": ["string", "null"],
          "enum": ["Agent", "Customer", null]
        },
        "status": {
          "type": "string",
          "enum": ["clear", "ambiguous", "overlap", "mixed", "excluded"]
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["method", "basis", "audio_verified"],
      "additionalProperties": false,
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "manual_audio_verification",
            "manual_transcript_review",
            "automated_content_inference"
          ]
        },
        "basis": {
          "type": "string",
          "enum": ["listen_pass", "asr_text_role", "regex_anchor"]
        },
        "audio_verified": {
          "description": "Must be true only after an actual listen-pass. Migrated transcript labels must be false.",
          "type": "boolean"
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        },
        "annotator": { "type": "string" },
        "source_system": { "type": "string" },
        "source_segment_index": { "type": ["integer", "null"], "minimum": 0 },
        "notes": { "type": "string" }
      }
    }
  }
}
