# LLM provider: openai, gemini, or groq.
LLM_PROVIDER=openai

# Optional provider-specific model ID; blank uses the provider default.
LLM_MODEL=

# Lower sampling variability for repeat reviews; range 0-2.
LLM_TEMPERATURE=0

# Required when LLM_PROVIDER=openai.
OPENAI_API_KEY=

# Required when LLM_PROVIDER=gemini.
GOOGLE_API_KEY=

# Required when LLM_PROVIDER=groq.
GROQ_API_KEY=

# Faster-Whisper model size. Examples: tiny, base, small, medium, large-v3.
WHISPER_MODEL_SIZE=base

# Load the speech model before serving requests. Disable for UI-only previews.
WHISPER_PRELOAD=true

# Rolling generated-file retention. Positive integer.
TEMP_FILE_RETENTION=50

# Application event logging: json or text; standard Python severity level.
LOG_FORMAT=json
LOG_LEVEL=INFO

# Diarization backend:
#   hybrid   — acoustic Community-1 first (bounded timeout), heuristic fallback
#   acoustic — Community-1 only (raises on timeout/failure; no silent fallback)
#   heuristic — Milestone 3 text heuristics only (reproducible baseline)
DIARIZATION_BACKEND=heuristic

# Required for local pyannote Community-1.
# 1) https://huggingface.co/settings/tokens
# 2) Accept terms: https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Local Community-1 only — do not use precision-2 hosted inference.
PYANNOTE_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# Acoustic hard-timeout policy (subprocess kill; no silent retry).
# If ACOUSTIC_TIMEOUT_SECONDS is set, it is a fixed timeout for every call.
# Otherwise: max(FLOOR, BASE + PER_AUDIO_SEC * audio_duration_seconds).
# ACOUSTIC_TIMEOUT_SECONDS=
ACOUSTIC_TIMEOUT_FLOOR_SEC=60
ACOUSTIC_TIMEOUT_BASE_SEC=30
ACOUSTIC_TIMEOUT_PER_AUDIO_SEC=2.5

# Optional verbose speaker-attribution diagnostics. Any non-empty value enables it.
# DIARIZATION_DEBUG=1

# Transcription confidence threshold. Must be between 0 and 1.
CONFIDENCE_THRESHOLD=0.5

# Maximum acceptable proportion of low-confidence transcription.
# Must be between 0 and 1.
LOW_CONFIDENCE_HALT_RATIO=0.5

# Path to the SQLite database.
DB_PATH=data/db.sqlite3

# Optional database encryption key.
# Leave blank unless encryption is configured.
DB_ENCRYPTION_KEY=

# Maximum attempts per pipeline node, including the initial call. Positive integer.
MAX_RETRIES_PER_NODE=3

# LLM request timeout in seconds. Must be a positive integer.
LLM_TIMEOUT_SECONDS=30

# Optional LangSmith tracing. Leave disabled for local-only observability.
# Review exported trace fields and LangSmith retention before enabling for real calls.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=call-center-intelligence
